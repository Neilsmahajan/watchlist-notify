# Runtime environment variables for Cloud Run deployments.
# Copy to cloudrun.env (listed in .gitignore) and populate with real secrets before running scripts/release.sh
# APP_ENV=production limits CORS to FRONTEND_URL's origin. FRONTEND_URL is
# also the site the digest email links to.
APP_ENV=production
BASE_URL=https://api.watchlistnotify.com
FRONTEND_URL=https://watchlistnotify.com
DB_DATABASE=watchlistnotify
JWT_SECRET=replace-with-strong-secret

# Auth0 configuration (reuse existing tenant until you provision dedicated prod credentials)
AUTH0_DOMAIN=dev-dpjez628xnoe24zj.us.auth0.com
AUTH0_AUDIENCE=https://api.watchlistnotify.com
# AUTH0_CLIENT_ID=your-auth0-client-id
# AUTH0_CLIENT_SECRET=your-auth0-client-secret

# MCP server (docs/MCP.md). The public URL of the MCP endpoint: it must end in
# /mcp and must be, character for character, the identifier of the Auth0 API
# that issues its tokens, because it is the audience every token is checked
# against. Leave it unset and the API serves no MCP routes at all.
MCP_RESOURCE_URL=https://api.watchlistnotify.com/mcp

# MongoDB Atlas (shared dev/prod cluster for now)
MONGODB_URI=mongodb+srv://neilsmahajan_db_user:<db_password>@devcluster.qjz5rjg.mongodb.net/?retryWrites=true&w=majority&appName=DevCluster

# TMDb configuration
TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TMDB_REGION=US
TMDB_BASE_URL=https://api.themoviedb.org/3

# Redis (Upstash) cache URL
REDIS_URL=rediss://default:*@exciting-bee-25303.upstash.io:6379

# Postmark
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_BASE_URL=https://api.postmarkapp.com/email

# "What should I watch tonight?" (POST /api/recommendations/tonight). The
# feature is off, and its panel hidden, unless ANTHROPIC_API_KEY is set: an
# Anthropic API key from https://platform.claude.com. Each pick that needs the
# model is one Claude API call, about a third of a cent at most with the
# default model (docs/API.md has the arithmetic).
# ANTHROPIC_API_KEY=sk-ant-...
# The model that picks. Default: claude-haiku-5-5, the cheapest current model.
# ANTHROPIC_MODEL=claude-haiku-5-5
# Spend limits per UTC day, checked before every call. A call that fails still
# counts. Defaults: 10 calls per user and 200 across all users, about $0.60 a
# day at the very most. Setting either to 0 turns the feature off; a value
# that is not a whole number does too, rather than being read as no limit.
# AI_DAILY_LIMIT_PER_USER=10
# AI_DAILY_LIMIT_TOTAL=200

# Worker job (scripts/release-worker.sh); the API ignores these.
# Tasks to run, in order. Default: refresh,imdb,digest
WORKER_TASKS=refresh,imdb,digest
# How long a title's availability is left alone before it is fetched again.
REFRESH_MIN_AGE=20h
# apply (default) syncs the watchlists of users who linked a public IMDb list,
# reading each list at most once a day. dry-run fetches the lists, logs what
# each sync would do and writes nothing.
IMDB_SYNC_MODE=apply
# dry-run (default) logs what would be sent and sends nothing. send delivers
# through Postmark, and only when the account's email is in DIGEST_ALLOWLIST
# and the address the digest goes to is the account's email or is also listed
# (comma-separated addresses). An empty allowlist emails no one.
DIGEST_MODE=dry-run
DIGEST_ALLOWLIST=you@example.com
