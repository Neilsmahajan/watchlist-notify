# Frontend (Next.js) environment variables for watchlist-notify.
# Auth0 values come from the Auth0 dashboard (Applications → the
# watchlist-notify SPA/Regular Web App). AUTH0_SECRET is a random 32-byte hex
# string used to encrypt the session cookie — generate one with:
#   openssl rand -hex 32
# See also .example.env at the repo root for backend variables.

AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_SCOPE=
NEXT_PUBLIC_AUTH0_AUDIENCE=

# URL of the Go backend
BACKEND_URL=http://localhost:8080
